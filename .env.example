# Public Firebase web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase Admin credentials (never expose as NEXT_PUBLIC_*)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin authorization
ADMIN_EMAIL=your-email@example.com

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public branding defaults (optional)
NEXT_PUBLIC_SITE_NAME=My Platform
NEXT_PUBLIC_SITE_TAGLINE=AI systems, automation, and digital engineering.

# Cloudinary signed-media configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=my-platform

# Optional email provider
RESEND_API_KEY=
RESEND_FROM_EMAIL=
