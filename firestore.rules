rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This application uses server-side Firebase Admin SDK APIs. Browser clients
    // may authenticate with Firebase Auth, but never read or write Firestore directly.
    // All application access is checked by server routes with verified ID tokens
    // and the server-managed admin custom claim.
    match /{document=**} { allow read, write: if false; }
  }
}
